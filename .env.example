# OneShelf configuration. Copy to `.env` (install.sh does this for you) and edit what you need.
# `.env` is yours and is never committed, never overwritten by install.sh, and never touched by update.sh.

# --- Where OneShelf listens ----------------------------------------------------------------------
# Loopback only by default: the library is reachable from this machine and nowhere else.
ONESHELF_BIND=127.0.0.1
ONESHELF_PORT=8420

# --- Who is trusted ------------------------------------------------------------------------------
# Leave empty for a local-only install. To use OneShelf from other devices on your own network, set
# the subnet you actually trust, e.g. 192.168.1.0/24, and set ONESHELF_BIND=0.0.0.0 above.
# Trust is decided by the real connection, never by a header (Master §28.2).
ONESHELF_TRUSTED_NETWORKS=
# Only set this if OneShelf genuinely sits behind a reverse proxy you control.
ONESHELF_TRUSTED_PROXIES=
# Host names this server will answer to. Add your machine's name if you reach it by name.
ONESHELF_ALLOWED_HOSTS=localhost

# --- Where your library lives --------------------------------------------------------------------
# Defaults keep everything under deploy/volumes/ next to the repository. Point these at real disks
# when you want to: use a dedicated absolute directory. Changing a path does not move files.
# Stop and copy existing files before changing paths. No symlinks, overlapping or shared directories.
# The keys directory holds the key for your saved source logins. Back it up separately from the rest,
# and note it is deliberately excluded from OneShelf's own backups (Master §33.3).
ONESHELF_DATA_PATH=./volumes/data
ONESHELF_PLUGIN_PATH=./volumes/plugins
ONESHELF_KEYS_PATH=./volumes/keys
ONESHELF_CONTENT_PATH=./volumes/content
ONESHELF_BACKUP_PATH=./volumes/backups

# --- Source Registry ------------------------------------------------------------------------------
# Where Sources → Source Registry finds adapters to install, reinstall or update: Official, Verified
# Community and Community adapters published from github.com/IPurplel/OneShelf-Adapters. It is read only
# when you open that screen; installed sources never depend on it. Leave empty to switch it off.
# (The older default, .../IPurplel/OneShelf/main/registry/index.json, is still accepted: the container reads it as this one.)
ONESHELF_REGISTRY_URL=https://raw.githubusercontent.com/IPurplel/OneShelf-Adapters/registry/index.json
# The first-party Registry: its Official and Verified Community tiers are controlled by the OneShelf
# project's own repository and are trusted without a signature — but only while ONESHELF_REGISTRY_URL is
# exactly this URL. Any other Registry's claims install as Community unless a key below signs them.
# Leave empty to trust no Registry by its tiers.
ONESHELF_FIRST_PARTY_REGISTRY_URL=https://raw.githubusercontent.com/IPurplel/OneShelf-Adapters/registry/index.json
# Optional: PUBLIC Ed25519 keys whose signatures make a package Official or Verified Community from any
# Registry ("key-id:base64,..."; list two while rotating keys). Signing is optional for the first-party
# Registry. Never put a private key here, or anywhere in this repository.
ONESHELF_REGISTRY_TRUSTED_KEYS=

# --- Image ---------------------------------------------------------------------------------------
# Built locally by install.sh. Change only if you publish your own image somewhere.
ONESHELF_IMAGE=oneshelf:local

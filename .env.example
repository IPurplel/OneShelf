# OneShelf configuration. Copy to `.env` (install.sh does this for you) and edit what you need.
# `.env` is yours and is never committed, never overwritten by install.sh, and never touched by update.sh.

# --- Where OneShelf listens ----------------------------------------------------------------------
# Loopback only by default: the library is reachable from this machine and nowhere else.
ONESHELF_BIND=127.0.0.1
ONESHELF_PORT=8420

# --- Who is trusted ------------------------------------------------------------------------------
# Leave empty for a local-only install. To use OneShelf from other devices on your own network, set
# the subnet you actually trust, e.g. 192.168.1.0/24, and set ONESHELF_BIND=0.0.0.0 above.
# Trust is decided by the real connection, never by a header (Master §28.2).
ONESHELF_TRUSTED_NETWORKS=
# Only set this if OneShelf genuinely sits behind a reverse proxy you control.
ONESHELF_TRUSTED_PROXIES=
# Host names this server will answer to. Add your machine's name if you reach it by name.
ONESHELF_ALLOWED_HOSTS=localhost

# --- Where your library lives --------------------------------------------------------------------
# Defaults keep everything under deploy/volumes/ next to the repository. Point these at real disks
# when you want to: an absolute path works, and your data moves with it.
# The keys directory holds the key for your saved source logins. Back it up separately from the rest,
# and note it is deliberately excluded from OneShelf's own backups (Master §33.3).
ONESHELF_DATA_PATH=./volumes/data
ONESHELF_PLUGIN_PATH=./volumes/plugins
ONESHELF_KEYS_PATH=./volumes/keys
ONESHELF_CONTENT_PATH=./volumes/content
ONESHELF_BACKUP_PATH=./volumes/backups

# --- Image ---------------------------------------------------------------------------------------
# Built locally by install.sh. Change only if you publish your own image somewhere.
ONESHELF_IMAGE=oneshelf:local

[Unit]
Description=Manga Downloader
Documentation=https://github.com/local/manga-downloader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@

Environment=PYTHONUNBUFFERED=1
Environment=MD_CONFIG_FILE=@CONFIG_DIR@/config.yaml
Environment=MD_CONFIG_DIR=@CONFIG_DIR@
Environment=MD_OUTPUT_DIR=@DATA_DIR@
Environment=MD_PORT=@PORT@

ExecStart=@APP_DIR@/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port @PORT@

Restart=on-failure
RestartSec=10

# Chromium spawns a lot of short-lived helper processes and file descriptors.
LimitNOFILE=32768
TasksMax=4096

# Hardening. NoNewPrivileges is deliberately left off: Chromium's setuid
# sandbox helper needs it, and the app already passes --no-sandbox for the
# unprivileged-container case.
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@DATA_DIR@ @CONFIG_DIR@

[Install]
WantedBy=multi-user.target
